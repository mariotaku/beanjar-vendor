From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mariotaku <git@mariotaku.me>
Date: Sun, 27 Sep 2026 00:26:29 +0900
Subject: [PATCH 1/3] ui/egl: add a surfaceless EGL display for hosts without a
 render node

egl_init() on a GBM build requires a DRM render node, GBM and
EGL_MESA_image_dma_buf_export. Hosts whose GL driver is not behind a
render node, such as Mesa's d3d12 driver on WSL2 (no /dev/dri, only
/dev/dxg), cannot use egl-headless or dbus,gl=on at all.

Add rendernode=surfaceless, which initialises an
EGL_MESA_platform_surfaceless display (pbuffer-capable configs, since
such a display has no window configs), and fall back to it when no
rendernode is given and the host has no render node.

Rendering (virglrenderer uses QEMU's display and contexts) does not need
dma-bufs. Their export is only needed to pass scanouts on, so add
qemu_egl_has_dmabuf_export() for the displays to check, and make
egl_get_fd_for_texture() fail instead of calling the missing
eglExportDMABUFImage*MESA entry points.
---
 include/ui/egl-helpers.h |  2 +
 qapi/ui.json             |  8 +++-
 qemu-options.hx          |  4 +-
 ui/egl-helpers.c         | 88 ++++++++++++++++++++++++++++++++++++++--
 4 files changed, 96 insertions(+), 6 deletions(-)

diff --git a/include/ui/egl-helpers.h b/include/ui/egl-helpers.h
index 4b8c0d228..4e32f4889 100644
--- a/include/ui/egl-helpers.h
+++ b/include/ui/egl-helpers.h
@@ -62,6 +62,7 @@ EGLSurface qemu_egl_init_surface_x11(EGLContext ectx, EGLNativeWindowType win);
 
 int qemu_egl_init_dpy_x11(EGLNativeDisplayType dpy, DisplayGLMode mode);
 int qemu_egl_init_dpy_mesa(EGLNativeDisplayType dpy, DisplayGLMode mode);
+int qemu_egl_init_dpy_surfaceless(DisplayGLMode mode);
 
 #endif
 
@@ -71,6 +72,7 @@ int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode);
 
 EGLContext qemu_egl_init_ctx(void);
 bool qemu_egl_has_dmabuf(void);
+bool qemu_egl_has_dmabuf_export(void);
 
 bool egl_init(const char *rendernode, DisplayGLMode mode, Error **errp);
 
diff --git a/qapi/ui.json b/qapi/ui.json
index c536d4e52..be11e91bc 100644
--- a/qapi/ui.json
+++ b/qapi/ui.json
@@ -1349,7 +1349,9 @@
 # EGL headless display options.
 #
 # @rendernode: Which DRM render node should be used.  Default is the
-#     first available node on the host.
+#     first available node on the host, or a surfaceless EGL display
+#     if the host has none.  "surfaceless" selects a surfaceless EGL
+#     display (EGL_MESA_platform_surfaceless) without a render node.
 #
 # Since: 3.1
 ##
@@ -1364,7 +1366,9 @@
 # @addr: The D-Bus bus address (default to the session bus).
 #
 # @rendernode: Which DRM render node should be used.  Default is the
-#     first available node on the host.
+#     first available node on the host, or a surfaceless EGL display
+#     if the host has none.  "surfaceless" selects a surfaceless EGL
+#     display (EGL_MESA_platform_surfaceless) without a render node.
 #
 # @p2p: Whether to use peer-to-peer connections (accepted through
 #     @add_client).
diff --git a/qemu-options.hx b/qemu-options.hx
index dc694a99a..b205c081b 100644
--- a/qemu-options.hx
+++ b/qemu-options.hx
@@ -2234,7 +2234,9 @@ SRST
     ``egl-headless[,rendernode=<file>]``
         Offload all OpenGL operations to a local DRI device. For any
         graphical display, this display needs to be paired with either
-        VNC or SPICE displays.
+        VNC or SPICE displays. ``rendernode=surfaceless`` uses a
+        surfaceless EGL display instead of a DRI device, which is also
+        the default when the host has no render node.
 
     ``vnc=<display>``
         Start a VNC server on display <display>
diff --git a/ui/egl-helpers.c b/ui/egl-helpers.c
index d59115948..7dcf420b8 100644
--- a/ui/egl-helpers.c
+++ b/ui/egl-helpers.c
@@ -283,6 +283,10 @@ int egl_get_fd_for_texture(uint32_t tex_id, EGLint *stride, EGLint *fourcc,
     EGLImageKHR image;
     EGLint num_planes, fd;
 
+    if (!qemu_egl_has_dmabuf_export()) {
+        return -1;
+    }
+
     image = eglCreateImageKHR(qemu_egl_display, eglGetCurrentContext(),
                               EGL_GL_TEXTURE_2D_KHR,
                               (EGLClientBuffer)(unsigned long)tex_id,
@@ -500,11 +504,22 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
         EGL_ALPHA_SIZE, 0,
         EGL_NONE,
     };
+    EGLint conf_att[G_N_ELEMENTS(conf_att_core)];
     EGLint major, minor;
     EGLBoolean b;
     EGLint n;
     bool gles = (mode == DISPLAY_GL_MODE_ES);
 
+    QEMU_BUILD_BUG_ON(sizeof(conf_att_core) != sizeof(conf_att_gles));
+    memcpy(conf_att, gles ? conf_att_gles : conf_att_core, sizeof(conf_att));
+#ifdef EGL_MESA_platform_surfaceless
+    if (platform == EGL_PLATFORM_SURFACELESS_MESA) {
+        /* a surfaceless display has no window configs; QEMU renders to FBOs */
+        assert(conf_att[0] == EGL_SURFACE_TYPE);
+        conf_att[1] = EGL_PBUFFER_BIT;
+    }
+#endif
+
     qemu_egl_display = qemu_egl_get_display(dpy, platform);
     if (qemu_egl_display == EGL_NO_DISPLAY) {
         error_report("egl: eglGetDisplay failed: %s", qemu_egl_get_error_string());
@@ -524,8 +539,7 @@ static int qemu_egl_init_dpy(EGLNativeDisplayType dpy,
         return -1;
     }
 
-    b = eglChooseConfig(qemu_egl_display,
-                        gles ? conf_att_gles : conf_att_core,
+    b = eglChooseConfig(qemu_egl_display, conf_att,
                         &qemu_egl_config, 1, &n);
     if (b == EGL_FALSE || n != 1) {
         error_report("egl: eglChooseConfig failed (%s mode): %s",
@@ -557,6 +571,36 @@ int qemu_egl_init_dpy_mesa(EGLNativeDisplayType dpy, DisplayGLMode mode)
     return qemu_egl_init_dpy(dpy, 0, mode);
 #endif
 }
+
+/*
+ * A display with no native window system and no DRM device
+ * (EGL_MESA_platform_surfaceless), for GL drivers that are not behind a
+ * render node, e.g. Mesa's d3d12 driver on WSL2.  Rendering works as usual;
+ * without a render node there is usually no EGL_MESA_image_dma_buf_export,
+ * so scanouts have to leave QEMU as pixels (see qemu_egl_has_dmabuf_export).
+ */
+int qemu_egl_init_dpy_surfaceless(DisplayGLMode mode)
+{
+#ifdef EGL_MESA_platform_surfaceless
+    if (!epoxy_has_egl_extension(NULL, "EGL_MESA_platform_surfaceless")) {
+        error_report("egl: EGL_MESA_platform_surfaceless not supported");
+        return -1;
+    }
+    if (qemu_egl_init_dpy(EGL_DEFAULT_DISPLAY, EGL_PLATFORM_SURFACELESS_MESA,
+                          mode) < 0) {
+        return -1;
+    }
+    if (!epoxy_has_egl_extension(qemu_egl_display,
+                                 "EGL_KHR_surfaceless_context")) {
+        error_report("egl: EGL_KHR_surfaceless_context not supported");
+        return -1;
+    }
+    return 0;
+#else
+    error_report("egl: built without EGL_MESA_platform_surfaceless");
+    return -1;
+#endif
+}
 #endif
 
 
@@ -598,6 +642,20 @@ int qemu_egl_init_dpy_win32(EGLNativeDisplayType dpy, DisplayGLMode mode)
 }
 #endif
 
+/*
+ * Whether GL textures can leave QEMU as dma-bufs (egl_get_fd_for_texture).
+ * False on a surfaceless display without EGL_MESA_image_dma_buf_export.
+ */
+bool qemu_egl_has_dmabuf_export(void)
+{
+    if (qemu_egl_display == EGL_NO_DISPLAY) {
+        return false;
+    }
+
+    return epoxy_has_egl_extension(qemu_egl_display,
+                                   "EGL_MESA_image_dma_buf_export");
+}
+
 bool qemu_egl_has_dmabuf(void)
 {
     if (qemu_egl_display == EGL_NO_DISPLAY) {
@@ -658,7 +716,31 @@ bool egl_init(const char *rendernode, DisplayGLMode mode, Error **errp)
         return false;
     }
 #elif defined(CONFIG_GBM)
-    if (egl_rendernode_init(rendernode, mode) < 0) {
+    bool surfaceless = rendernode && g_str_equal(rendernode, "surfaceless");
+
+    if (!rendernode) {
+        int fd = qemu_drm_rendernode_open(NULL);
+
+        if (fd < 0) {
+            warn_report("egl: no DRM render node available, "
+                        "using a surfaceless EGL display");
+            surfaceless = true;
+        } else {
+            close(fd);
+        }
+    }
+
+    if (surfaceless) {
+        if (qemu_egl_init_dpy_surfaceless(mode) < 0) {
+            error_setg(errp, "egl: surfaceless display init failed");
+            return false;
+        }
+        qemu_egl_rn_ctx = qemu_egl_init_ctx();
+        if (!qemu_egl_rn_ctx) {
+            error_setg(errp, "egl: egl_init_ctx failed");
+            return false;
+        }
+    } else if (egl_rendernode_init(rendernode, mode) < 0) {
         error_setg(errp, "egl: render node init failed");
         return false;
     }
