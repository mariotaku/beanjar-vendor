+/*
+ * Without dma-buf export (e.g. a surfaceless EGL display on a GL driver
+ * that is not behind a render node), GL scanouts are read back with
+ * glReadPixels and sent like 2D surfaces: shared with ScanoutMap/UpdateMap
+ * if the listener implements org.qemu.Display1.Listener.Unix.Map, otherwise
+ * copied into Scanout/Update messages.
+ */
+static bool dbus_gl_readback(void)
+{
+    return !qemu_egl_has_dmabuf_export();
+}
+#endif
+
 static void dbus_scanout_disable(DisplayChangeListener *dcl)
 {
     DBusDisplayListener *ddl = container_of(dcl, DBusDisplayListener, dcl);
 
     ddl_discard_display_messages(ddl);
+#ifndef WIN32
+    ddl->gl_sent = false;
+#endif
 
     qemu_dbus_display1_listener_call_disable(
         ddl->proxy, G_DBUS_CALL_FLAGS_NONE, -1, NULL, NULL, NULL);
@@ -237,15 +268,114 @@ static void dbus_update_gl_cb(GObject *source_object,
 }
 #endif
 
+#ifndef WIN32
+static void ddl_scanout(DBusDisplayListener *ddl, DisplaySurface *ds);
+static void dbus_gfx_update_sub(DBusDisplayListener *ddl, DisplaySurface *ds,
+                                int x, int y, int w, int h);
+
+static void dbus_update_map_cb(GObject *source_object,
+                               GAsyncResult *res,
+                               gpointer user_data)
+{
+    g_autoptr(GError) err = NULL;
+    DBusDisplayListener *ddl = user_data;
+
+    if (!qemu_dbus_display1_listener_unix_map_call_update_map_finish(
+            ddl->map_proxy, res, &err)) {
+        error_report("Failed to call update: %s", err->message);
+    }
+
+    graphic_hw_gl_block(ddl->dcl.con, false);
+    g_object_unref(ddl);
+}
+
+/* Read a rectangle of the scanout into gl_ds (surface coordinates). */
+static void dbus_gl_read_rect(DBusDisplayListener *ddl,
+                              int x, int y, int w, int h)
+{
+    int height = surface_height(ddl->gl_ds);
+    int src_y0, src_y1;
+
+    /*
+     * Copy it upright into gl_fb, so that framebuffer rows are surface rows
+     * (as egl-headless does with the whole frame), then read it.
+     */
+    if (ddl->gl_y0_top) {
+        src_y0 = ddl->gl_y + height - y;
+        src_y1 = src_y0 - h;
+    } else {
+        src_y0 = ddl->gl_y + y;
+        src_y1 = src_y0 + h;
+    }
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, ddl->gl_src_fb.framebuffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, ddl->gl_fb.framebuffer);
+    glBlitFramebuffer(ddl->gl_x + x, src_y0, ddl->gl_x + x + w, src_y1,
+                      x, y, x + w, y + h, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+    egl_fb_read_rect(ddl->gl_ds, &ddl->gl_fb, x, y, w, h);
+}
+
+static void dbus_update_gl_readback(DBusDisplayListener *ddl,
+                                    int x, int y, int w, int h)
+{
+    int width, height;
+
+    if (!ddl->gl_ds || !ddl->gl_sent) {
+        return;
+    }
+    width = surface_width(ddl->gl_ds);
+    height = surface_height(ddl->gl_ds);
+
+    if (ddl->gl_full) {
+        /* a new scanout texture: none of gl_ds is current */
+        x = y = 0;
+        w = width;
+        h = height;
+        ddl->gl_full = false;
+    } else {
+        w = MIN(x + w, width) - MAX(x, 0);
+        h = MIN(y + h, height) - MAX(y, 0);
+        x = MAX(x, 0);
+        y = MAX(y, 0);
+        if (w <= 0 || h <= 0) {
+            return;
+        }
+    }
+
+    trace_dbus_gl_readback(x, y, w, h, ddl->gl_mapped);
+    dbus_gl_read_rect(ddl, x, y, w, h);
+
+    if (ddl->gl_mapped) {
+        /* no new frame is read into the mapping until the listener is done */
+        graphic_hw_gl_block(ddl->dcl.con, true);
+        qemu_dbus_display1_listener_unix_map_call_update_map(
+            ddl->map_proxy,
+            x, y, w, h,
+            G_DBUS_CALL_FLAGS_NONE,
+            DBUS_DEFAULT_TIMEOUT, NULL,
+            dbus_update_map_cb,
+            g_object_ref(ddl));
+    } else if (w == width && h == height) {
+        ddl_scanout(ddl, ddl->gl_ds);
+    } else {
+        dbus_gfx_update_sub(ddl, ddl->gl_ds, x, y, w, h);
+    }
+}
+#endif /* !WIN32 */
