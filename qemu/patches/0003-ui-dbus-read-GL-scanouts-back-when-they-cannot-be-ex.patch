+    egl_fb gl_fb;               /* the scanout rectangle, row 0 at the top */
+    uint32_t gl_x, gl_y;        /* the scanout rectangle in the texture */
+    bool gl_y0_top;
+    DisplaySurface *gl_ds;      /* a8r8g8b8, shareable (memfd) */
+    bool gl_sent;               /* the listener has gl_ds (Scanout[Map]) */
+    bool gl_mapped;             /* ... as a shared mapping (ScanoutMap) */
+    bool gl_full;               /* the next update reads the whole frame */
+#endif
 #endif
 
