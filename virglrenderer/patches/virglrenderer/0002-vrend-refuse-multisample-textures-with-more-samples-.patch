From 6826b3f5132bbbdc4c1e98a9525a8a370eb2993a Mon Sep 17 00:00:00 2001
From: Ngo Quoc Dat <datlechin@gmail.com>
Date: Wed, 11 Nov 2026 09:56:31 +0700
Subject: [PATCH 2/7] vrend: refuse multisample textures with more samples than
 the format has

A host's GL refuses a multisample texture with more samples than its
format allows, which vrend did not notice, so the resource was created
without storage and every later use of it failed. Where
glGetInternalformativ is available, from OpenGL 4.2 and OpenGL ES 3.0, the
format check now records each format's largest sample count, and a
resource asking for more is refused like any other invalid resource.

The test creates a 4-sample B8G8R8A8 texture and is refused a 64-sample
one.

Signed-off-by: Ngo Quoc Dat <datlechin@gmail.com>
---
 src/vrend/vrend_formats.c   | 12 ++++++++--
 src/vrend/vrend_renderer.c  | 13 +++++++++-
 src/vrend/vrend_renderer.h  |  5 +++-
 tests/test_virgl_resource.c | 47 +++++++++++++++++++++++++++++++++++++
 4 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/src/vrend/vrend_formats.c b/src/vrend/vrend_formats.c
index 670b3a40..0cc481e0 100644
--- a/src/vrend/vrend_formats.c
+++ b/src/vrend/vrend_formats.c
@@ -646,7 +646,8 @@ void vrend_check_texture_storage(struct vrend_format_table *table)
 }
 
 void vrend_check_texture_multisample(struct vrend_format_table *table,
-                                     bool enable_storage)
+                                     bool enable_storage,
+                                     bool query_samples)
 {
    bool is_desktop_gl = epoxy_is_desktop_gl();
    for (int i = 0; i < VIRGL_FORMAT_MAX_EXTENDED; i++) {
@@ -666,8 +667,15 @@ void vrend_check_texture_multisample(struct vrend_format_table *table,
             glTexImage2DMultisample(GL_TEXTURE_2D_MULTISAMPLE, 2,
                                     table[i].internalformat, 32, 32, GL_TRUE);
          }
-         if (glGetError() == GL_NO_ERROR)
+         if (glGetError() == GL_NO_ERROR) {
             table[i].flags |= VIRGL_TEXTURE_CAN_MULTISAMPLE;
+            if (query_samples) {
+               GLint max_samples = 2;
+               glGetInternalformativ(GL_TEXTURE_2D_MULTISAMPLE, table[i].internalformat,
+                                     GL_SAMPLES, 1, &max_samples);
+               table[i].max_samples = glGetError() == GL_NO_ERROR ? max_samples : 2;
+            }
+         }
          glDeleteTextures(1, &tex_id);
       }
    }
diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 5bd362e0..84643c87 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -175,6 +175,7 @@ enum features_id
    feat_indep_blend_func,
    feat_indirect_draw,
    feat_indirect_params,
+   feat_internalformat_query,
    feat_khr_debug,
    feat_memory_object,
    feat_memory_object_fd,
@@ -288,6 +289,7 @@ static const  struct {
    FEAT(indep_blend_func, 40, 32,  "GL_ARB_draw_buffers_blend", "GL_OES_draw_buffers_indexed"),
    FEAT(indirect_draw, 40, 31,  "GL_ARB_draw_indirect" ),
    FEAT(indirect_params, 46, UNAVAIL,  "GL_ARB_indirect_parameters" ),
+   FEAT(internalformat_query, 42, 30,  "GL_ARB_internalformat_query" ),
    FEAT(khr_debug, 43, 32,  "GL_KHR_debug" ),
    FEAT(memory_object, UNAVAIL, UNAVAIL, "GL_EXT_memory_object"),
    FEAT(memory_object_fd, UNAVAIL, UNAVAIL, "GL_EXT_memory_object_fd"),
@@ -7712,7 +7714,8 @@ int vrend_renderer_init(const struct vrend_if_cbs *cbs, uint32_t flags)
 
    if (has_feature(feat_multisample)) {
       vrend_check_texture_multisample(tex_conv_table,
-                                      has_feature(feat_storage_multisample));
+                                      has_feature(feat_storage_multisample),
+                                      has_feature(feat_internalformat_query));
    }
 
    /* disable for format testing */
@@ -8094,6 +8097,14 @@ static int check_resource_valid(const struct vrend_renderer_resource_create_args
          snprintf(errmsg, 256, "Multisample textures not 2D (target:%d)", args->target);
          return -1;
       }
+      /* The host's GL refuses a larger count without vrend noticing. */
+      if (tex_conv_table[args->format].max_samples &&
+          args->nr_samples > tex_conv_table[args->format].max_samples) {
+         snprintf(errmsg, 256, "Multisample %s textures have at most %u samples (asked %u)",
+                  util_format_name(args->format), tex_conv_table[args->format].max_samples,
+                  args->nr_samples);
+         return -1;
+      }
       /* multisample can't have miplevels */
       if (args->last_level > 0) {
          snprintf(errmsg, 256, "Multisample textures don't support mipmaps");
diff --git a/src/vrend/vrend_renderer.h b/src/vrend/vrend_renderer.h
index 8b59c2f7..0930f397 100644
--- a/src/vrend/vrend_renderer.h
+++ b/src/vrend/vrend_renderer.h
@@ -174,6 +174,8 @@ struct vrend_format_table {
    enum view_class view_class;
    uint32_t bindings;
    uint32_t flags;
+   /* the largest sample count, 0 where the host cannot tell */
+   uint32_t max_samples;
 };
 
 typedef void (*vrend_context_fence_retire)(uint64_t fence_id,
@@ -500,7 +502,8 @@ void vrend_build_format_list_gles(void);
 void vrend_build_emulated_format_list_gles(void);
 void vrend_check_texture_storage(struct vrend_format_table *table);
 void vrend_check_texture_multisample(struct vrend_format_table *table,
-                                     bool enable_storage);
+                                     bool enable_storage,
+                                     bool query_samples);
 
 struct vrend_resource *vrend_renderer_ctx_res_lookup(struct vrend_context *ctx,
                                                      int res_handle);
diff --git a/tests/test_virgl_resource.c b/tests/test_virgl_resource.c
index 8297b55d..2593770a 100644
--- a/tests/test_virgl_resource.c
+++ b/tests/test_virgl_resource.c
@@ -304,6 +304,52 @@ START_TEST(private_ptr)
 }
 END_TEST
 
+static bool host_has_multisample_textures(void)
+{
+  uint32_t max_ver, max_size;
+  struct virgl_caps_v1 *caps;
+  bool has;
+
+  /* capability set 1, VIRGL */
+  virgl_renderer_get_cap_set(1, &max_ver, &max_size);
+  caps = calloc(1, max_size);
+  virgl_renderer_fill_caps(1, max_ver, caps);
+  has = caps->bset.texture_multisample;
+  free(caps);
+  return has;
+}
+
+/* A multisample texture asking for more samples than its format has is
+ * refused, where the host's GL would leave it without storage. */
+START_TEST(virgl_test_multisample_sample_count)
+{
+  struct virgl_renderer_resource_create_args args;
+  int ret;
+
+  testvirgl_init_single_ctx_nr();
+  if (!host_has_multisample_textures()) {
+    testvirgl_fini_single_ctx();
+    return;
+  }
+
+  testvirgl_init_simple_2d_resource(&args, 1);
+  args.format = PIPE_FORMAT_B8G8R8A8_UNORM;
+  args.bind = PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+  args.nr_samples = 4;
+  ret = virgl_renderer_resource_create(&args, NULL, 0);
+  ck_assert_int_eq(ret, 0);
+  virgl_renderer_resource_unref(1);
+
+  /* more than any OpenGL implementation has */
+  args.handle = 2;
+  args.nr_samples = 64;
+  ret = virgl_renderer_resource_create(&args, NULL, 0);
+  ck_assert_int_eq(ret, EINVAL);
+
+  testvirgl_fini_single_ctx();
+}
+END_TEST
+
 static Suite *virgl_init_suite(void)
 {
   Suite *s;
@@ -315,6 +361,7 @@ static Suite *virgl_init_suite(void)
   tcase_add_loop_test(tc_core, virgl_res_tests, 0, ARRAY_SIZE(testlist));
   tcase_add_loop_test(tc_core, cubemaparray_res_tests, 0, ARRAY_SIZE(cubemaparray_testlist));
   tcase_add_test(tc_core, private_ptr);
+  tcase_add_test(tc_core, virgl_test_multisample_sample_count);
   suite_add_tcase(s, tc_core);
   return s;
 
