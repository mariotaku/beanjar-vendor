From 7c27895628315d7f1b6ef5d973664c36b5b35df2 Mon Sep 17 00:00:00 2001
From: Ngo Quoc Dat <datlechin@gmail.com>
Date: Wed, 11 Nov 2026 10:01:58 +0700
Subject: [PATCH 5/7] vrend: read zero-stride integer vertex attributes in
 their format

Without ARB_vertex_attrib_binding, vrend sets an attribute of zero stride
as a constant: it maps as many floats as the format has channels at the
binding's offset and sets them with glVertexAttrib*fv. For an integer
attribute that reads the wrong bytes, ignores the element's offset, and
sets a float value on what is now an integer input.

Such an attribute is now read in its own format at the element's offset,
mapping only the format's bytes, each channel sign or zero extended, and
set with glVertexAttribI4iv or glVertexAttribI4uiv. A value past the end
of its buffer reads as zero instead of failing the map.

The test draws with an unsigned 8-bit and a signed 16-bit constant at
offsets into one buffer.

Signed-off-by: Ngo Quoc Dat <datlechin@gmail.com>
---
 src/vrend/vrend_renderer.c | 60 +++++++++++++++++++++++++++++++++++++-
 tests/test_virgl_cmd.c     | 19 ++++++++++++
 2 files changed, 78 insertions(+), 1 deletion(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index ac1d1e8f..dde084df 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -5198,6 +5198,61 @@ static GLenum get_xfb_mode(GLenum mode)
    }
 }
 
+/* A zero-stride integer attribute: one value read in the element's format at
+ * its offset, each channel widened with its sign, set on an integer input. */
+static void vrend_set_integer_attrib_value(GLint loc,
+                                           const struct vrend_vertex_element *ve,
+                                           const struct vrend_resource *res,
+                                           uint32_t buffer_offset)
+{
+   const struct util_format_description *desc = util_format_description(ve->base.src_format);
+   const unsigned size = util_format_get_blocksize(ve->base.src_format);
+   const uint64_t offset = (uint64_t)buffer_offset + ve->base.src_offset;
+   /* room past the block for the eight bytes each channel is read from */
+   uint8_t block[16 + 8] = { 0 };
+   GLuint value[4] = { 0, 0, 0, 1 };
+
+   if (!desc)
+      return;
+
+   /* a value past the buffer reads as zero instead of failing the map */
+   if (size <= 16 && offset + size <= res->base.width0) {
+      const void *data = glMapBufferRange(GL_ARRAY_BUFFER, offset, size, GL_MAP_READ_BIT);
+      if (data) {
+         memcpy(block, data, size);
+         glUnmapBuffer(GL_ARRAY_BUFFER);
+      }
+   }
+
+   GLuint channels[4] = { 0, 0, 0, 0 };
+   for (unsigned c = 0; c < desc->nr_channels && c < 4; c++) {
+      const struct util_format_channel_description *channel = &desc->channel[c];
+      uint64_t bits = 0;
+      if (channel->size == 0 || channel->size > 32 || channel->shift / 8 + 8 > sizeof(block))
+         continue;
+      for (unsigned b = 0; b < 8; b++)
+         bits |= (uint64_t)block[channel->shift / 8 + b] << (8 * b);
+      bits = (bits >> (channel->shift % 8)) & ((1ull << channel->size) - 1);
+      if (channel->type == UTIL_FORMAT_TYPE_SIGNED && (bits >> (channel->size - 1)) & 1)
+         bits |= ~0ull << channel->size;
+      channels[c] = (GLuint)bits;
+   }
+
+   for (unsigned i = 0; i < 4; i++) {
+      if (desc->swizzle[i] <= PIPE_SWIZZLE_W)
+         value[i] = channels[desc->swizzle[i]];
+      else if (desc->swizzle[i] == PIPE_SWIZZLE_0)
+         value[i] = 0;
+      else if (desc->swizzle[i] == PIPE_SWIZZLE_1)
+         value[i] = 1;
+   }
+
+   if (util_format_is_pure_sint(ve->base.src_format))
+      glVertexAttribI4iv(loc, (const GLint *)value);
+   else
+      glVertexAttribI4uiv(loc, value);
+}
+
 static void vrend_draw_bind_vertex_legacy(struct vrend_context *ctx,
                                           struct vrend_vertex_element_array *va)
 {
@@ -5250,7 +5305,10 @@ static void vrend_draw_bind_vertex_legacy(struct vrend_context *ctx,
 
       struct vrend_vertex_buffer *vbo = &ctx->sub->vbo[vbo_index];
 
-      if (vbo->base.stride == 0) {
+      if (vbo->base.stride == 0 && util_format_is_pure_integer(ve->base.src_format)) {
+         vrend_set_integer_attrib_value(loc, ve, res, vbo->base.buffer_offset);
+         disable_bitmask |= (1 << loc);
+      } else if (vbo->base.stride == 0) {
          void *data;
          /* for 0 stride we are kinda screwed */
          data = glMapBufferRange(GL_ARRAY_BUFFER, vbo->base.buffer_offset, ve->nr_chan * sizeof(GLfloat), GL_MAP_READ_BIT);
diff --git a/tests/test_virgl_cmd.c b/tests/test_virgl_cmd.c
index 6f826c1a..08664b45 100644
--- a/tests/test_virgl_cmd.c
+++ b/tests/test_virgl_cmd.c
@@ -775,6 +775,24 @@ START_TEST(virgl_test_render_integer_attribute)
 }
 END_TEST
 
+/* A zero-stride integer attribute is one value, read in its own format at the
+ * element's offset, each channel widened with its sign. */
+START_TEST(virgl_test_render_integer_constant)
+{
+   static const uint8_t bytes[16] = {
+      0, 0, 0, 0, 64, 128, 192, 255, 0xc0, 0xff, 0xff, 0xff, 0, 0, 0x7f, 0,
+   };
+
+   check_texel_rgb(draw_integer_attribute(PIPE_FORMAT_R8G8B8A8_UINT, false, 0, 4,
+                                          bytes, sizeof(bytes)),
+                   64, 128, 192);
+   /* -64, -1, 0 and 127 as 16-bit values */
+   check_texel_rgb(draw_integer_attribute(PIPE_FORMAT_R16G16B16A16_SINT, true, 0, 8,
+                                          bytes, sizeof(bytes)),
+                   64, 127, 128);
+}
+END_TEST
+
 static void virgl_test_bind_images_shader(int first_layer, int last_layer, int expected_error)
 {
     struct virgl_context ctx;
@@ -2267,6 +2285,7 @@ static Suite *virgl_init_suite(void)
   tcase_add_test(tc_core, virgl_test_large_shader);
   tcase_add_test(tc_core, virgl_test_render_simple);
   tcase_add_test(tc_core, virgl_test_render_integer_attribute);
+  tcase_add_test(tc_core, virgl_test_render_integer_constant);
   tcase_add_test(tc_core, virgl_test_render_geom_simple);
   tcase_add_test(tc_core, virgl_test_render_xfb);
   tcase_add_test(tc_core, virgl_test_set_viewport_state);
-- 
