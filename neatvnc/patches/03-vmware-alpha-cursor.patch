--- a/test/test_rfb_handshake.py
+++ b/test/test_rfb_handshake.py
@@ -428,6 +428,62 @@ class TestAuthBypass(unittest.TestCase):
             self.assertEqual(struct.unpack('!I', data)[0], 1)
 
 
+
+ENCODING_CURSOR = -239
+ENCODING_VMWARE_CURSOR = 0x574d5664
+
+
+class TestCursor(unittest.TestCase):
+    """The server's 2x1 cursor (hotspot 1,0; opaque red, then green at
+    alpha 64), as the Cursor and VMware cursor pseudo-encodings send it."""
+
+    server = None
+
+    @classmethod
+    def setUpClass(cls):
+        cls.server = ServerProcess('none')
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.server.stop()
+
+    def first_rect(self, encodings):
+        """Connect, ask for ENCODINGS and an update; the first rectangle's
+        header (x, y, w, h, encoding) and the connection."""
+        c = RFBConnection(self.server.port, 'RFB 003.008\n')
+        c.read_security_type_list()
+        c.choose_security_type(1)
+        self.assertEqual(c.read_security_result(), 0)
+        c.sock.sendall(b'\x01')  # ClientInit, shared
+        init = c.recv_exact(24)
+        c.recv_exact(struct.unpack('!I', init[20:24])[0])  # the name
+        c.sock.sendall(struct.pack('!BxH', 2, len(encodings)) +
+                       b''.join(struct.pack('!i', e) for e in encodings))
+        c.sock.sendall(struct.pack('!BBHHHH', 3, 0, 0, 0, 64, 64))
+        msg_type, n_rects = struct.unpack('!BxH', c.recv_exact(4))
+        self.assertEqual(msg_type, 0)
+        self.assertGreaterEqual(n_rects, 1)
+        return struct.unpack('!HHHHi', c.recv_exact(12)), c, init
+
+    def test_vmware_alpha_cursor(self):
+        """VMware's cursor, type 1: R, G, B and straight alpha bytes."""
+        head, c, _ = self.first_rect([0, ENCODING_VMWARE_CURSOR,
+                                      ENCODING_CURSOR])
+        with c:
+            self.assertEqual(head, (1, 0, 2, 1, ENCODING_VMWARE_CURSOR))
+            self.assertEqual(c.recv_exact(2), b'\x01\x00')
+            self.assertEqual(c.recv_exact(8),
+                             bytes([255, 0, 0, 255, 0, 255, 0, 64]))
+
+    def test_cursor_bit_mask(self):
+        """Without VMware's: the Cursor pseudo-encoding, alpha 64 masked."""
+        head, c, init = self.first_rect([0, ENCODING_CURSOR])
+        with c:
+            self.assertEqual(head, (1, 0, 2, 1, ENCODING_CURSOR))
+            c.recv_exact(2 * init[4] // 8)  # the pixels
+            self.assertEqual(c.recv_exact(1), b'\x80')
+
+
 if __name__ == '__main__':
