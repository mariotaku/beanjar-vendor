+/*
+ * VMware's cursor pseudo-encoding (0x574d5664) with cursor type 1, alpha: a
+ * byte of type, a byte of padding, then width * height pixels of four bytes
+ * each, R, G, B and straight alpha, whatever the client's pixel format. Unlike
+ * the Cursor pseudo-encoding's one-bit mask it keeps translucent pixels.
+ */
+int cursor_encode_vmware_alpha(struct vec* dst, struct nvnc_frame* image,
+		uint32_t hotspot_x, uint32_t hotspot_y)
+{
+	static const uint8_t type_alpha[2] = { 1, 0 };
+	int rc = -1;
+
+	// Empty cursor
+	if (!image) {
+		rc = nvnc__encode_rect_head(dst, RFB_ENCODING_VMWARE_CURSOR, 0,
+				0, 0, 0);
+		return rc < 0 ? rc : vec_append(dst, type_alpha,
+				sizeof(type_alpha));
+	}
+
+	if (nvnc_frame_map(image) < 0)
+		return -1;
+
+	struct nvnc_composite_fb cfb = {
+		.n_fbs = 1,
+		.fbs = { image },
+	};
+
+	uint32_t width = nvnc_composite_fb_width(&cfb);
+	uint32_t height = nvnc_composite_fb_height(&cfb);
+
+	// ABGR8888 is R, G, B, A in memory: the bytes on the wire
+	struct nvnc_frame* fb = nvnc_frame_new(width, height,
+			DRM_FORMAT_ABGR8888, width);
+	if (!fb)
+		return -1;
+
+	composite_buffer_now(fb, &cfb, NULL);
+
+	rc = nvnc__encode_rect_head(dst, RFB_ENCODING_VMWARE_CURSOR, hotspot_x,
+			hotspot_y, width, height);
+	if (rc < 0)
+		goto failure;
+
+	rc = vec_append(dst, type_alpha, sizeof(type_alpha));
+	if (rc < 0)
+		goto failure;
+
+	rc = vec_append(dst, fb->buffer->addr, (size_t)width * height * 4);
+
+failure:
+	nvnc_frame_unref(fb);
+	return rc < 0 ? -1 : 0;
+}
