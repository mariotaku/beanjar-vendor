# Beanjar's test guest userland: armv7 EABI with the soft-float calling convention and VFPv3/NEON
# hardware (softfp), glibc, as webOS's userland; Buildroot's own toolchain (no external toolchain
# is built for this ABI). BusyBox init, Mesa with the virgl gallium driver only (EGL, OpenGL ES,
# GBM), a squashfs root filesystem.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_EABI=y
BR2_ARM_FPU_NEON=y
BR2_ARM_INSTRUCTIONS_ARM=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# glibc takes the headers' version as the oldest kernel it runs on (--enable-kernel); the oldest
# Buildroot offers, well below the guest kernel
BR2_KERNEL_HEADERS_5_10=y
BR2_CCACHE=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="beanjar-testguest"
BR2_TARGET_GENERIC_ISSUE="Beanjar test guest"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_TARGET_GENERIC_GETTY_PORT="hvc0"
BR2_SYSTEM_DHCP=""
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZO=y
# BR2_TARGET_ROOTFS_TAR is not set
